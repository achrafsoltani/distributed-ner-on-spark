# Optional environment variables. Export them in your shell (or your IDE's run
# configuration); no script reads a .env file. Never commit real values.

# Hugging Face access token. Not needed to download the public models in this
# package; set it only if you hit anonymous rate limits.
# Generate one at https://huggingface.co/settings/tokens
HF_TOKEN=

# Hugging Face cache root (optional; defaults to ~/.cache/huggingface).
HF_HOME=
